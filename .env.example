# Copy this file to .env.local for local development.
# In production these are set in Vercel: Project → Settings → Environment Variables.
# See concept/11-config-specification.md for the full explanation of each.

# --- Clash of Clans ---
COC_API_TOKEN=
COC_API_BASE_URL=https://cocproxy.royaleapi.dev/v1

# --- DATABASE_URL is required for local dev. Set up a Supabase project, go to
# Project Settings -> Database, and copy the Transaction Pooler connection string (port 6543).
DATABASE_URL=

# --- Ingestion security ---
# Generate both with: openssl rand -hex 32
# INGEST_SECRET is sent as `Authorization: Bearer <INGEST_SECRET>` by the
# third-party cron-job service that triggers /api/ingest (see concept/04).
INGEST_SECRET=
# Vercel does NOT generate this for you — set it yourself, same as
# INGEST_SECRET. Vercel then automatically sends it as the Authorization
# header when it invokes /api/cron/purge on schedule.
CRON_SECRET=

# --- Administrator session protection (Phase 2) ---
# Protects write actions (roster drafts, settings) without a player account
# system. See concept/11-config-specification.md §"Administrative protection"
# and concept/12 Step 2.0.
#
# ADMIN_PASSWORD_HASH: scrypt hash of the admin password. Generate with:
#   node -e "const{scryptSync,randomBytes}=require('crypto');const p='YOUR_PASSWORD';const s=randomBytes(16);const h=scryptSync(p,s,64).toString('hex');console.log('scrypt:'+s.toString('hex')+':'+h)"
# Format: scrypt:<salt-hex>:<hash-hex>
# Uses ':' as the delimiter (not '$') because Next.js's dotenv loader expands
# '$' as a variable reference, which would silently strip the salt and hash.
# The generation command uses the Buffer form for the salt to match the
# verifier, which decodes the hex salt to raw bytes before deriving.
ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET: HMAC key for signing session tokens. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=
